# Copy this file to .env and fill in the values.

# FREE mode (default): Google Gemini free tier
PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Paid mode instead: PROVIDER=anthropic + ANTHROPIC_API_KEY, and uncomment anthropic in requirements.txt
# ANTHROPIC_API_KEY=sk-ant-...

# Where the digest goes
MY_EMAIL=you@gmail.com
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=

# true = save the email to outbox/ instead of sending. Switch to false when you're happy.
DRY_RUN=true

MIN_FIT_SCORE=7
MAX_CVS_PER_RUN=3
